# TEENETWORK Environment Configuration

# Database: PostgreSQL connection string (Provided automatically on Railway)
# If omitted during local development, TEENETWORK will run in local storage mode.
DATABASE_URL=postgresql://postgres:password@localhost:5432/teenetwork

# JWT Secret for signing session authentication tokens
JWT_SECRET=your-secure-random-jwt-secret-key-min-32-chars

# Port the Express server listens on (defaults to 3000)
PORT=3000

# Administrator email. An account created with this email is automatically granted admin rights.
ADMIN_EMAIL=admin@teenetwork.org

# Optional: Email Service for password resets (Resend API)
RESEND_API_KEY=
RESEND_FROM=TEENETWORK <onboarding@resend.dev>

# Optional: Public URL for password reset links in emails
APP_URL=http://localhost:3000

# Optional emergency admin password reset (remove after use)
# RESET_ADMIN_PASSWORD=newSecurePassword123
